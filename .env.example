# ---- Database (MongoDB Atlas). Use a NEW database name, e.g. carequeue_v2 ----
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/carequeue_v2?retryWrites=true&w=majority

# ---- Redis slot lock (Upstash). Leave empty locally to use an in-memory lock ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Google login ----
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ---- Sessions: any long random string ----
JWT_SECRET=change-this-to-a-long-random-string

# ---- Who is admin: comma separated Google emails ----
ADMIN_EMAILS=you@gmail.com

# ---- Razorpay (leave empty to allow only "pay at counter") ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (free: Gmail App Password or Brevo SMTP). Empty = prints to logs ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CareQueue <your-gmail@gmail.com>
HOSPITAL_NAME=CareQueue

# ---- Misc ----
TZ_NAME=Asia/Kolkata
SERVICE_MIN=8
